<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/farmer_surface"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDialogWasteTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♻️ List New Agri Waste"
            android:textColor="@color/farmer_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Turn your crop residue and farm bi-products into revenue"
            android:textColor="@color/farmer_text_secondary"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/farmer_stroke" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Waste Category"
            android:textColor="@color/farmer_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDialogWasteType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypeStraw"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="🌾 Wheat/Rice Straw" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypeSugarcane"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎋 Sugarcane Residue" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypeMaize"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌱 Maize / Stalks" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypeCotton"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☁️ Cotton Stalk" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypeHusk"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥥 Husk / Shell" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypeOther"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♻️ Other Residue" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Waste Title / Name (e.g. Dry Wheat Straw)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogWasteName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dry Wheat Straw (गव्हाचे काड)" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quantity and Unit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Quantity">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDialogWasteQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="15" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Unit (Tons/Quintals)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDialogWasteUnit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tons" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Price and Price Unit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Price (₹)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDialogWastePrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="1800" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Price Unit">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDialogWastePriceUnit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="per ton" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Available Date and Pickup -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Available Date">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDialogWasteAvailableDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Immediate / Today" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Pickup Option">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDialogWastePickupOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Buyer Pickup &amp; Delivery" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Village">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDialogWasteVillage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Narayangaon" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Taluka">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDialogWasteTaluka"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Junnar" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Description &amp; Quality Notes">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogWasteDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lines="3"
                android:text="High dry matter sun-dried wheat straw. Tractor trolley access available directly to farm storage shed." />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelWasteDialog"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/farmer_text_secondary"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublishWasteDialog"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/farmer_primary"
                android:text="Publish Waste"
                android:textColor="@color/white"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
