<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/farmer_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarSeller"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/farmer_primary"
            app:title="🏪 Seller Store &amp; Inventory"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/white" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Seller Profile Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/farmer_stroke"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/farmer_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <FrameLayout
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:background="@drawable/bg_circle_light_green"
                                android:backgroundTint="@color/farmer_light_bg">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="🏪"
                                    android:textSize="26sp" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvSellerShopName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/farmer_text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:text="Kisan Agri Mart &amp; Seed Center" />

                                <TextView
                                    android:id="@+id/tvSellerOwnerAndPhone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/farmer_text_secondary"
                                    android:textSize="12sp"
                                    tools:text="Anil Kadam • +91 98220 54321" />

                                <TextView
                                    android:id="@+id/tvSellerLocation"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/farmer_primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    tools:text="📍 Narayangaon, Junnar (Pune) • GSTIN: 27AABCU9603R1ZM" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvSellerVerifiedBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@color/farmer_light_bg"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:textColor="@color/farmer_primary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:text="✓ Verified" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4 Metrics Dashboard Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <!-- Metric 1: Total Listed -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/farmer_stroke"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@color/farmer_surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📦 Total Listed"
                                android:textColor="@color/farmer_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvMetricTotalProducts"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/farmer_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="18" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Metric 2: Active Stock -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/farmer_stroke"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@color/farmer_surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🟢 In Stock"
                                android:textColor="@color/farmer_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvMetricActiveProducts"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/farmer_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="17" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- Metric 3: Orders Pending -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/farmer_stroke"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@color/farmer_surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏳ Orders Pending"
                                android:textColor="@color/farmer_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvMetricPendingOrders"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/farmer_warning"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="3" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Metric 4: Total Revenue -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/farmer_stroke"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@color/farmer_surface">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💰 Total Revenue"
                                android:textColor="@color/farmer_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvMetricTotalRevenue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/farmer_primary_dark"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="₹3,85,000" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Dual Tabs: [MY PRODUCTS & INVENTORY] | [FARMER ORDERS] -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayoutSeller"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_rounded_light_green"
                    app:tabIndicatorColor="@color/farmer_primary"
                    app:tabSelectedTextColor="@color/farmer_primary"
                    app:tabTextColor="@color/farmer_text_secondary"
                    app:tabMode="fixed">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 Products &amp; Stock" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋 Farmer Orders" />
                </com.google.android.material.tabs.TabLayout>

                <!-- Product Filters Container -->
                <HorizontalScrollView
                    android:id="@+id/scrollSellerFilters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupSellerCategories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSellerCatAll"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="All Products"
                            android:checked="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSellerCatSeeds"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌱 Seeds" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSellerCatFertilizers"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🧪 Fertilizers" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSellerCatCropProtection"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛡️ Crop Protection" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSellerCatEquipment"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚜 Equipment" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSellerCatTools"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛠️ Tools" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/layoutEmptySeller"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:gravity="center"
                    android:visibility="gone"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦"
                        android:textSize="48sp" />

                    <TextView
                        android:id="@+id/tvEmptySellerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="No products in this category"
                        android:textColor="@color/farmer_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEmptySellerSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tap + Add Product below to list agricultural supplies"
                        android:textColor="@color/farmer_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Products RecyclerView (When Tab 0) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSellerProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_product_card" />

                <!-- Orders RecyclerView (When Tab 1) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSellerOrders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"
                    tools:listitem="@layout/item_seller_order" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- Floating Action Button for Adding New Product -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddProduct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="Add Product"
        android:textColor="@color/white"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/white"
        app:backgroundTint="@color/farmer_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
