<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/farmer_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/farmer_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBuyerWasteTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dry Wheat Straw (5 Tons)"
                    android:textColor="@color/farmer_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBuyerNameType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏢 BioEnergy Pellets Pvt Ltd • Biomass Factory"
                    android:textColor="@color/farmer_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRequestStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waiting for Farmer"
                android:textColor="@color/farmer_warning"
                app:chipBackgroundColor="@color/farmer_light_bg"
                app:chipStrokeColor="@color/farmer_stroke"
                app:chipStrokeWidth="1dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/farmer_stroke" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Requested Quantity"
                    android:textColor="@color/farmer_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvReqQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5.0 Tons @ ₹1,800/ton"
                    android:textColor="@color/farmer_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Amount"
                    android:textColor="@color/farmer_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvReqTotalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹9,000"
                    android:textColor="@color/farmer_primary_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvReqPickupDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="🚚 Delivery Partner • Proposed Date: 06 Sept 2026"
            android:textColor="@color/farmer_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvReqBuyerAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="📍 Delivery: Narayangaon Pellet Processing Unit, Junnar"
            android:textColor="@color/farmer_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/layoutRequestActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRejectBuyerRequest"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:text="[REJECT]"
                android:textColor="@color/farmer_error"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/farmer_error" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptBuyerRequest"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="@color/farmer_primary"
                android:text="[ACCEPT]"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
