<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📢 Post Bulk Buying Requirement"
            android:textColor="@color/farmer_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Broadcast your wholesale demand directly to registered farmers"
            android:textColor="@color/farmer_text_secondary"
            android:textSize="13sp" />

        <!-- Crop Name -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Crop / Commodity Name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReqCropName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="Wheat" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Required Quantity in Tons -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Required Volume (in Tons)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReqQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:text="25.0" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Offered Price per Quintal -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Offered Price (₹ / quintal)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReqPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:text="2500" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quality Requirements -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Quality &amp; Moisture Requirements">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReqQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:lines="2"
                android:text="FAQ Grade A, Moisture &lt;11%, Protein &gt;13%" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Required By Date -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Required Delivery By Date">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReqDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="30 Nov 2026" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Pickup Location -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Delivery Hub / Farm Gate Pickup">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReqLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="Pune APMC Hub &amp; Farm Gate" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Payment Terms -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Payment Terms">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReqPaymentTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="Immediate RTGS / NEFT on weighbridge receipt" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelReqDialog"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="@color/farmer_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublishReqDialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/farmer_primary"
                android:text="Publish Requirement"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
