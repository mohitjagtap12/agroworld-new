<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_dialog_produce_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛒 List Farm Produce"
            android:textColor="#2E7D32"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sell directly to local consumers and wholesale buyers with maximum profits."
            android:textColor="#666666"
            android:textSize="13sp" />

        <!-- Emoji Selector Row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Select Produce Icon:"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipgroup_produce_emojis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_emoji_tomato"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="🍅 Tomato" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_emoji_onion"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧅 Onion" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_emoji_grain"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌾 Grain / Rice" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_emoji_mango"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥭 Mango" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_emoji_turmeric"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🫚 Turmeric" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_emoji_capsicum"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🫑 Capsicum" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_emoji_chilli"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌶️ Chilli" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_emoji_potato"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥔 Potato" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Produce Name Input -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Produce Name *"
            app:boxStrokeColor="#2E7D32"
            app:hintTextColor="#2E7D32">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_produce_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:text="Fresh Hybrid Red Tomato" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Category Spinner / Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Category *"
            app:boxStrokeColor="#2E7D32">

            <AutoCompleteTextView
                android:id="@+id/actv_produce_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:text="Vegetables" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quantity and Unit Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Quantity *"
                app:boxStrokeColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_produce_qty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="500" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Unit *"
                app:boxStrokeColor="#2E7D32">

                <AutoCompleteTextView
                    android:id="@+id/actv_produce_unit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:text="kg" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Price and Quality Grade Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Price (₹ / Unit) *"
                app:boxStrokeColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_produce_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="30" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Quality Grade *"
                app:boxStrokeColor="#2E7D32">

                <AutoCompleteTextView
                    android:id="@+id/actv_produce_grade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:text="Grade A Export" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Harvest Date & Available Until Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Harvest Date"
                app:boxStrokeColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_produce_harvest_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 September 2026" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Available Until"
                app:boxStrokeColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_produce_valid_until"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="25 September 2026" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Village and Taluka Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Village *"
                app:boxStrokeColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_produce_village"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Baramati" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Taluka *"
                app:boxStrokeColor="#2E7D32">

                <AutoCompleteTextView
                    android:id="@+id/actv_produce_taluka"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:text="Baramati" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Description -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Description / Special Quality Note"
            app:boxStrokeColor="#2E7D32">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_produce_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:lines="3"
                android:text="Freshly harvested glossy firm red tomatoes. Chemical pesticide free and natural." />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_produce"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:text="Cancel"
                android:textColor="#666666" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_publish_produce"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="#2E7D32"
                android:text="Publish Listing"
                android:textColor="@color/white"
                app:cornerRadius="24dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
