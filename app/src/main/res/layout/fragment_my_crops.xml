<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/farmer_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar / Title -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarMyCrops"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/farmer_surface"
            android:elevation="2dp"
            app:title="🌱 My Crops &amp; Field Health"
            app:titleTextColor="@color/farmer_text_primary" />

        <!-- Quick Summary Banner -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/farmer_light_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/farmer_secondary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTotalCropsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 Crops Active"
                        android:textColor="@color/farmer_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalLandMonitored"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="5.5 Acres cultivated in Junnar cluster"
                        android:textColor="@color/farmer_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickAiAllCrops"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan Leaf"
                    android:textColor="@color/farmer_primary"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_camera"
                    app:iconTint="@color/farmer_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layoutEmptyCrops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌾"
                android:textSize="54sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No Crops Added Yet"
                android:textColor="@color/farmer_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Add your currently sown or planned crops to track irrigation, harvest timelines, and AI disease health."
                android:textColor="@color/farmer_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Crops RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCrops"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="88dp"
            tools:itemCount="3"
            tools:listitem="@layout/item_crop_card" />

    </LinearLayout>

    <!-- Floating Action Button for Add Crop -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddCrop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:backgroundTint="@color/farmer_accent"
        android:text="Add Crop"
        android:textColor="@color/farmer_text_primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/farmer_text_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
