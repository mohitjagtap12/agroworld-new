<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌾 Submit Bulk Supply Offer"
            android:textColor="@color/farmer_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRequirementSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Broker Dinesh Deshmukh is buying Wheat @ ₹2,500/quintal"
            android:textColor="@color/farmer_text_secondary"
            android:textSize="13sp" />

        <!-- Live Value Highlight Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#E8F5E9"
            app:cardCornerRadius="12dp"
            app:strokeColor="#A5D6A7"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimated Deal Payout"
                    android:textColor="#2E7D32"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLiveCalculatedPayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="₹2,04,000 (8 Tons = 80 Quintals × ₹2,550)"
                    android:textColor="#1B5E20"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Available Quantity Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAvailableQty"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Available Quantity (in Tons)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAvailableQty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:text="8.0" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Expected Price Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilExpectedPrice"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Expected Price (₹ / quintal)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExpectedPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:text="2550" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Available Date Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAvailableDate"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Available for Pickup Date">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAvailableDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="15 Nov 2026" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quality Details Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilQualityDetails"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Crop Quality &amp; Storage Details">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etQualityDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:lines="2"
                android:text="High grade golden Sharbati wheat, cleaned and bagged, moisture 10.5%" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Message / Farm Gate Pickup Note -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMessage"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Message to Broker / Pickup Address">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:lines="2"
                android:text="Harvested recently, direct truck access available at Narayangaon farm." />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelOfferDialog"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="@color/farmer_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitOfferDialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/farmer_primary"
                android:text="Submit Offer"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
