<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/farmer_card_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/farmer_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header: Category Icon, Title, Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvActivityEmoji"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@color/farmer_light_bg"
                android:gravity="center"
                android:text="🛒"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@id/tvActivityEmoji"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvActivityTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pune Red Onions (5 Quintal)"
                    android:textColor="@color/farmer_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActivityCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Direct Produce • APMC Wholesaler"
                    android:textColor="@color/farmer_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvActivityStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@color/farmer_light_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Pending"
                android:textColor="@color/farmer_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Counterparty & Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvActivityCounterparty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Customer: Suresh Mehta"
                android:textColor="@color/farmer_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvActivityDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 Aug 2026"
                android:textColor="@color/farmer_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Amount and Details Strip -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/farmer_background"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvActivityDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tvActivityAmount"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Delivery: Wagholi APMC, Pune"
                android:textColor="@color/farmer_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvActivityAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="₹9,750"
                android:textColor="@color/farmer_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
