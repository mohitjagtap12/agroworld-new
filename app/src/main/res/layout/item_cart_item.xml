<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/farmer_stroke"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/farmer_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_light_green"
                android:backgroundTint="@color/farmer_light_bg">

                <TextView
                    android:id="@+id/tvCartItemEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textSize="26sp"
                    tools:text="🌱" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCartItemName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/farmer_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Wheat Seeds (HD-2967)" />

                <TextView
                    android:id="@+id/tvCartItemSeller"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/farmer_text_secondary"
                    android:textSize="12sp"
                    tools:text="Seller: Kisan Agri Mart" />

                <TextView
                    android:id="@+id/tvCartUnitPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/farmer_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="₹120 / kg" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnRemoveCartItem"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_delete"
                android:contentDescription="Remove item"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/farmer_stroke" />

        <!-- Stepper and Subtotal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Stepper Container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_rounded_light_green"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCartMinus"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:text="-"
                    android:textColor="@color/farmer_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCartItemQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:textColor="@color/farmer_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="2 kg" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCartPlus"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:text="+"
                    android:textColor="@color/farmer_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subtotal"
                    android:textColor="@color/farmer_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvCartItemSubtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/farmer_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="₹240" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
