<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_track_emoji"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_light_green"
                android:gravity="center"
                android:text="🍅"
                android:textSize="24sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_track_order_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order #ORD-101"
                    android:textColor="#2E7D32"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_track_produce_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fresh Hybrid Red Tomato (10.0 kg)"
                    android:textColor="#555555"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Current Status Banner -->
        <LinearLayout
            android:id="@+id/layout_track_current_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#E8F5E9"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_track_status_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_track_status_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Order Placed"
                    android:textColor="#1B5E20"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_track_status_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Waiting for farmer review &amp; confirmation."
                    android:textColor="#388E3C"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 6 Step Tracking Timeline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Order Timeline:"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <!-- Step 1: Order Placed -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/iv_step_1"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_step_active"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_step_1_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Order Placed"
                        android:textColor="#2E7D32"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_step_1_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order received and stock reserved from field."
                        android:textColor="#666666"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/line_step_1"
                android:layout_width="2dp"
                android:layout_height="20dp"
                android:layout_marginStart="13dp"
                android:background="#2E7D32" />

            <!-- Step 2: Farmer Accepted -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/iv_step_2"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_step_inactive"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_step_2_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Farmer Confirmed"
                        android:textColor="#757575"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_step_2_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Farmer confirmed produce availability &amp; harvest."
                        android:textColor="#888888"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/line_step_2"
                android:layout_width="2dp"
                android:layout_height="20dp"
                android:layout_marginStart="13dp"
                android:background="#CCCCCC" />

            <!-- Step 3: Preparing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/iv_step_3"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_step_inactive"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_step_3_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3. Harvesting &amp; Packing"
                        android:textColor="#757575"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_step_3_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fresh produce sorted, weighed &amp; securely packed."
                        android:textColor="#888888"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/line_step_3"
                android:layout_width="2dp"
                android:layout_height="20dp"
                android:layout_marginStart="13dp"
                android:background="#CCCCCC" />

            <!-- Step 4: Ready for Pickup -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/iv_step_4"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_step_inactive"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_step_4_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4. Ready for Pickup"
                        android:textColor="#757575"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_step_4_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ready at farm gate or staging point for vehicle pickup."
                        android:textColor="#888888"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/line_step_4"
                android:layout_width="2dp"
                android:layout_height="20dp"
                android:layout_marginStart="13dp"
                android:background="#CCCCCC" />

            <!-- Step 5: Out for Delivery -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/iv_step_5"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_step_inactive"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_step_5_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5. Out for Delivery"
                        android:textColor="#757575"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_step_5_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vehicle is in transit to your delivery destination."
                        android:textColor="#888888"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/line_step_5"
                android:layout_width="2dp"
                android:layout_height="20dp"
                android:layout_marginStart="13dp"
                android:background="#CCCCCC" />

            <!-- Step 6: Delivered -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/iv_step_6"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_step_inactive"
                    android:gravity="center"
                    android:text="6"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_step_6_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6. Delivered"
                        android:textColor="#757575"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_step_6_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Produce received and order successfully completed."
                        android:textColor="#888888"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Close Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_track_dialog"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#2E7D32"
            android:text="Close Tracking"
            android:textColor="@color/white"
            app:cornerRadius="24dp" />

    </LinearLayout>
</ScrollView>
