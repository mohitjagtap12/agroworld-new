<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_checkout_produce_emoji"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_light_green"
                android:gravity="center"
                android:text="🍅"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_checkout_produce_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fresh Hybrid Red Tomato"
                    android:textColor="#2E7D32"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_checkout_farmer_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="👨‍🌾 Vitthal Deshmukh • Baramati"
                    android:textColor="#666666"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Price & Available Stock Info Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#F5F9F4"
            android:orientation="horizontal"
            android:padding="12dp"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unit Price"
                    android:textColor="#888888"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_checkout_unit_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="₹30.0 / kg"
                    android:textColor="#2E7D32"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available In Stock"
                    android:textColor="#888888"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_checkout_available_stock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="500.0 kg"
                    android:textColor="#212121"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quantity Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Select Order Quantity:"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_qty_minus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="0dp"
                android:text="-"
                android:textColor="#2E7D32"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="22dp"
                app:strokeColor="#2E7D32" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_checkout_quantity"
                android:layout_width="100dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_round_input"
                android:gravity="center"
                android:inputType="numberDecimal"
                android:padding="0dp"
                android:text="10"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_checkout_unit_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="kg"
                android:textColor="#555555"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_qty_plus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="#2E7D32"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="22dp"
                app:strokeColor="#2E7D32" />
        </LinearLayout>

        <!-- Quick Quantity Preset Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_preset_5"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="5 kg"
                    android:textColor="#2E7D32"
                    android:textSize="11sp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_preset_10"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="10 kg"
                    android:textColor="#2E7D32"
                    android:textSize="11sp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_preset_25"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="25 kg"
                    android:textColor="#2E7D32"
                    android:textSize="11sp"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_preset_50"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="50 kg"
                    android:textColor="#2E7D32"
                    android:textSize="11sp"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Calculated Total Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_total_card"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Amount Payable:"
                android:textColor="#1B5E20"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_checkout_total_calc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹300.0"
                android:textColor="#1B5E20"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Customer Delivery Details Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Delivery Information:"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Your Name *"
            app:boxStrokeColor="#2E7D32">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_checkout_customer_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Abhishek Sharma" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Phone Number *"
            app:boxStrokeColor="#2E7D32">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_checkout_customer_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:text="+91 98765 43210" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Delivery Address / Flat / Landmark *"
            app:boxStrokeColor="#2E7D32">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_checkout_delivery_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lines="2"
                android:text="Flat 402, Building B, Kothrud Heights, Pune" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:hint="Village / Area"
                app:boxStrokeColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_checkout_village"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kothrud" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:hint="Taluka"
                app:boxStrokeColor="#2E7D32">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_checkout_taluka"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Haveli" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Payment Mode Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Payment Mode:"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_checkout_payment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/rb_pay_online"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="💳 UPI / Online Payment (Instant Confirmation)"
                android:textColor="#212121"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb_pay_cod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💵 Cash on Delivery (Pay upon harvest pickup/delivery)"
                android:textColor="#212121"
                android:textSize="13sp" />
        </RadioGroup>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_checkout"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:text="Cancel"
                android:textColor="#666666" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_checkout"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="#2E7D32"
                android:text="Place Order Now"
                android:textColor="@color/white"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_check_circle"
                app:iconTint="@color/white" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
