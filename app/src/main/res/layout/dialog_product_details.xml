<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header: Emoji + Title + Category -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circle_light_green"
                android:backgroundTint="@color/farmer_light_bg">

                <TextView
                    android:id="@+id/tvDetailEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textSize="36sp"
                    tools:text="🍅" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetailCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/farmer_light_bg"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/farmer_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Seeds • Syngenta India" />

                <TextView
                    android:id="@+id/tvDetailName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/farmer_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Hybrid Tomato Seeds F1 (Abhinav)" />
            </LinearLayout>
        </LinearLayout>

        <!-- Price & Stock Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_rounded_light_green"
            android:padding="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Market Price"
                    android:textColor="@color/farmer_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDetailPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/farmer_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="₹450 / packet" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stock Availability"
                    android:textColor="@color/farmer_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDetailStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/farmer_primary_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="120 packet Available" />
            </LinearLayout>
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Product Details &amp; Specifications"
            android:textColor="@color/farmer_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/farmer_text_secondary"
            android:textSize="13sp"
            tools:text="Indeterminate hybrid tomato seeds known for exceptional vigor, disease tolerance, and extended harvest cycles." />

        <!-- Suitable Crops & Advisory -->
        <TextView
            android:id="@+id/tvDetailSuitableCrops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/farmer_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="🌱 Commonly used for: Tomato, Chilli, Vegetables" />

        <!-- Chemical & Label Safety Notice (User Requirement Section 2) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFF9C4"
            android:padding="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvDetailAdvisory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textColor="#F57F17"
                android:textSize="11sp"
                android:text="Follow manufacturer product label directions and local agricultural guidance." />
        </LinearLayout>

        <!-- Seller Store Info -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/farmer_stroke"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/farmer_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetailSellerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/farmer_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="🏪 Kisan Agri Mart &amp; Seed Center" />

                <TextView
                    android:id="@+id/tvDetailSellerLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/farmer_text_secondary"
                    android:textSize="12sp"
                    tools:text="📍 Narayangaon, Junnar (Pune) • ⭐ 4.8 Rating" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quantity Selector Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select Quantity:"
                android:textColor="@color/farmer_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_rounded_light_green"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetailMinus"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:text="-"
                    android:textColor="@color/farmer_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailSelectedQty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/farmer_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetailPlus"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:text="+"
                    android:textColor="@color/farmer_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons: ADD TO CART & BUY NOW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailAddToCart"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="ADD TO CART"
                android:textColor="@color/farmer_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:strokeColor="@color/farmer_primary"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailBuyNow"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="BUY NOW"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/farmer_primary"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
