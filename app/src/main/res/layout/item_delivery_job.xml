<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Order Type Badge & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvOrderTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_status_green"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="🏪 Seller Product"
                android:textColor="#2E7D32"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvDeliveryStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_status_blue"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="AVAILABLE"
                android:textColor="#0061A4"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Delivery ID and Timing -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDeliveryJobId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEL-2026-000101"
                android:textColor="#616161"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="#9E9E9E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvOrderIdRef"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ref: AW-ORD-8091"
                android:textColor="#757575"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDeliveryFee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹280 Fee"
                android:textColor="#2E7D32"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="#F0F0F0" />

        <!-- Item Summary with Emoji -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvItemEmoji"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_rounded_light_green"
                android:gravity="center"
                android:text="🧪"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvItemsSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Water Soluble NPK 19:19:19 (5 Bags)"
                    android:textColor="#212121"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvQuantityAndDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Weight: 125.0 kg • Approx 42.0 km"
                    android:textColor="#616161"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Route Visualization (Pickup & Destination) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_stats"
            android:padding="12dp">

            <!-- Pickup Point -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_location"
                    app:tint="#2E7D32" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PICKUP FROM"
                        android:textColor="#2E7D32"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSourceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kisan Agri Mart &amp; Seed Center"
                        android:textColor="#212121"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSourceAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Shop 14, APMC Market Yard Complex, Pune"
                        android:textColor="#616161"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnCallSource"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_phone"
                    app:tint="#2E7D32"
                    android:contentDescription="Call Source" />
            </LinearLayout>

            <!-- Route Divider Connector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="7dp"
                android:layout_marginVertical="4dp">

                <View
                    android:layout_width="2dp"
                    android:layout_height="16dp"
                    android:background="#A5D6A7" />
            </LinearLayout>

            <!-- Delivery Drop Point -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_location"
                    app:tint="#D32F2F" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DELIVER TO"
                        android:textColor="#D32F2F"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDestinationName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rameshwar Patil (Farmer)"
                        android:textColor="#212121"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDestinationAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gat 112, Narayangaon, Junnar Taluka, Pune"
                        android:textColor="#616161"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnCallDestination"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_phone"
                    app:tint="#2E7D32"
                    android:contentDescription="Call Destination" />
            </LinearLayout>
        </LinearLayout>

        <!-- Vehicle Type & Special Instructions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvVehicleRequired"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚚 Pickup Truck"
                android:textColor="#424242"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="#9E9E9E" />

            <TextView
                android:id="@+id/tvPickupTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pickup: Today, 02:30 PM"
                android:textColor="#616161"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Delivery Notes if any -->
        <TextView
            android:id="@+id/tvDeliveryNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Note: Fragile packaging. Customer requested evening delivery."
            android:textColor="#757575"
            android:textSize="11sp"
            android:fontFamily="sans-serif-light" />

        <!-- Dynamic Action Buttons Section -->
        <LinearLayout
            android:id="@+id/layoutActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end">

            <!-- Decline / Reject (Shown for available jobs) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeclineJob"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:text="Decline"
                android:textColor="#BA1A1A"
                app:strokeColor="#BA1A1A"
                android:textSize="12sp" />

            <!-- Primary Action Button (Accept / Schedule / Pick Up / In Transit / Deliver) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrimaryAction"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Accept Delivery"
                android:textColor="@android:color/white"
                app:backgroundTint="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
