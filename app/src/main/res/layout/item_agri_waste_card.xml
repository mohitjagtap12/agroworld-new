<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/farmer_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/farmer_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWasteImageEmoji"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_light_green"
                android:gravity="center"
                android:text="🌾"
                android:textSize="24sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWasteName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dry Wheat Straw (गव्हाचे काड)"
                    android:textColor="@color/farmer_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWasteCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category: Straw • High Dry Matter"
                    android:textColor="@color/farmer_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWasteStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available"
                android:textColor="@color/farmer_primary_dark"
                app:chipBackgroundColor="@color/farmer_light_bg"
                app:chipStrokeColor="@color/farmer_stroke"
                app:chipStrokeWidth="1dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/farmer_stroke" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available Quantity"
                    android:textColor="@color/farmer_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvWasteQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15.0 Tons"
                    android:textColor="@color/farmer_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price per Unit"
                    android:textColor="@color/farmer_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvWastePrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹1,800 / ton"
                    android:textColor="@color/farmer_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvWasteLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📍 Narayangaon, Junnar • Pickup: Both"
            android:textColor="@color/farmer_text_secondary"
            android:textSize="12sp" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteWaste"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:text="[DELETE]"
                android:textColor="@color/farmer_error"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/farmer_error" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditWaste"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:text="[EDIT]"
                android:textColor="@color/farmer_primary"
                android:textSize="12sp"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewWaste"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="@color/farmer_primary"
                android:text="[VIEW]"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
